# ── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Exact production frontend origin (scheme + host + port). No trailing slash.
CLIENT_URL=http://localhost:3000
# Optional extra allowed origins, comma separated (e.g. staging + production).
ADDITIONAL_CLIENT_URLS=

# ── MongoDB (keep secret — never commit .env) ─────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pizzahub?retryWrites=true&w=majority
MONGODB_DB_NAME=pizzahub

# ── Better Auth / JWT (used to sign & verify tokens) ──────
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-string
BETTER_AUTH_URL=http://localhost:5000

# ── Google OAuth (for Better Auth social login) ───────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Stripe (server-side only, never expose to client) ─────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PREMIUM_PRICE_ID=price_xxx

# ── ImgBB (menu image uploads, proxied through server) ────
IMGBB_API_KEY=

# ── Admin seed (used by `npm run seed:admin` only) ────────
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@pizzahub.com
ADMIN_PASSWORD=Admin123
